<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="12dp"
        android:background="@drawable/bg_pill_button"
        android:backgroundTint="?attr/colorOutline" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:text="@string/resources_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="2dp"
        android:text="@string/resources_subtitle"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <!-- Add Resource Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="20dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_resource_url"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:hint="@string/resources_add_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingHorizontal="14dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_add_resource"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary"
            android:text="@string/resources_add_btn"
            android:textColor="@color/onPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Popular CDN presets chips -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="20dp"
        android:text="@string/popular_libraries"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_popular_cdns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <!-- Chips injected programmatically: Tailwind, Bootstrap, jQuery, React, Vue, FontAwesome, etc. -->

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Active Resources List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_active_resources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="240dp" />

</LinearLayout>
