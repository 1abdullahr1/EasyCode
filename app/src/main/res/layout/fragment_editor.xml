<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_background">

    <!-- Scrollable Code Workspace -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Line Numbers Gutter -->
            <TextView
                android:id="@+id/tv_line_numbers"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@color/editor_gutter_bg"
                android:fontFamily="monospace"
                android:gravity="top|end"
                android:lineSpacingExtra="4dp"
                android:paddingEnd="8dp"
                android:paddingStart="4dp"
                android:paddingTop="12dp"
                android:paddingBottom="48dp"
                android:text="1"
                android:textColor="@color/editor_gutter_text"
                android:textSize="13sp" />

            <!-- Code Editor Field -->
            <EditText
                android:id="@+id/et_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint=""
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:lineSpacingExtra="4dp"
                android:minLines="25"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="48dp"
                android:textColor="@color/editor_text"
                android:textColorHighlight="@color/editor_selection"
                android:textColorHint="@color/editor_gutter_text"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Mini Floating Quick Actions: Undo, Redo, Format, Copy -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="12dp"
        android:background="@drawable/bg_editor_container"
        android:orientation="horizontal"
        android:padding="2dp">

        <ImageButton
            android:id="@+id/btn_undo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_undo"
            app:tint="@color/editor_gutter_text"
            android:contentDescription="@string/action_undo" />

        <ImageButton
            android:id="@+id/btn_redo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_redo"
            app:tint="@color/editor_gutter_text"
            android:contentDescription="@string/action_redo" />

        <ImageButton
            android:id="@+id/btn_format"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_format"
            app:tint="@color/editor_gutter_text"
            android:contentDescription="@string/action_format" />

        <ImageButton
            android:id="@+id/btn_copy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_copy"
            app:tint="@color/editor_gutter_text"
            android:contentDescription="@string/copied_to_clipboard" />

    </LinearLayout>

</RelativeLayout>
