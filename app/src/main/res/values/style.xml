<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CodeEditorText">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">top|start</item>
        <item name="android:textColor">@color/editor_text</item>
        <item name="android:textColorHighlight">@color/editor_selection</item>
        <item name="android:background">@null</item>
        <item name="android:padding">8dp</item>
        <item name="android:scrollbars">vertical|horizontal</item>
    </style>

    <style name="CodeToolbarButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">38dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <style name="ConsoleFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">8dp</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
